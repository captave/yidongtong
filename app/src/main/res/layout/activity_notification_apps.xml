<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surface" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:background="@color/card" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/notificationAppsBackButton"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_apps_back"
            android:padding="12dp" android:src="@drawable/ic_arrow_back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1"
            android:text="@string/notification_apps_title" android:textColor="@color/ink"
            android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/card" android:orientation="vertical"
        android:paddingStart="20dp" android:paddingTop="18dp" android:paddingEnd="20dp"
        android:paddingBottom="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/notification_apps_section" android:textColor="@color/ink"
            android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:lineSpacingExtra="3dp"
            android:text="@string/notification_apps_desc" android:textColor="@color/ink_secondary"
            android:textSize="14sp" />
        <TextView android:id="@+id/notificationAppsSelectionSummary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/ink"
            android:textSize="15sp" android:textStyle="bold" />
        <Button android:id="@+id/notificationAppsKeepSmsButton" style="@style/SettingsTextButton"
            android:layout_marginTop="6dp" android:text="@string/notification_apps_keep_sms" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <ListView android:id="@+id/notificationAppsList" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="@color/card"
            android:divider="@color/line" android:dividerHeight="1dp"
            android:scrollbars="vertical" />
        <TextView android:id="@+id/notificationAppsEmpty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:padding="32dp"
            android:text="@string/notification_apps_empty" android:textColor="@color/ink_secondary"
            android:textSize="16sp" android:visibility="gone" />
    </FrameLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:paddingStart="20dp" android:paddingTop="14dp"
        android:paddingEnd="20dp" android:paddingBottom="16dp" android:text="@string/notification_apps_footer"
        android:textColor="@color/ink_secondary" android:textSize="13sp" />
</LinearLayout>
